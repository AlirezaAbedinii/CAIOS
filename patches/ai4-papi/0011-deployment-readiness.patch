+# [CAIOS] Three helpers for describing a deployment honestly. All are pure
+# functions over data `get_deployment` has already fetched, so they cost no
+# extra Nomad calls and can be unit-tested without a cluster.
+
+
+def unstarted_user_tasks(tasks, alloc):
+    """Names of the tasks a user actually opens that Nomad has not started yet.
+
+    Tasks carrying a `lifecycle` block are plumbing: prestart sidecars and
+    one-shot setup. The tasks without one are the deployment proper. Nomad has
+    not started a task until it has a StartedAt, which it serialises either as
+    null or as the zero time.
+    """
+    states = alloc.get("TaskStates") or {}
+    unstarted = []
+    for t in tasks:
+        if t.get("Lifecycle"):
+            continue
+        started = (states.get(t["Name"]) or {}).get("StartedAt")
+        if not started or (
+            isinstance(started, str) and started.startswith("0001-01-01")
+        ):
+            unstarted.append(t["Name"])
+    return unstarted
+
+
+def deployment_is_ready(tasks, services, alloc):
+    """Whether a user can open this deployment, not merely whether it started.
+
+    Two conditions, because a container starting is not a socket listening:
+
+    * every task without a `lifecycle` block has started. `main` may itself be
+      a prestart sidecar, in which case its state says nothing useful;
+    * and, where the group defines its own health checks, Nomad has marked the
+      allocation healthy. Nomad's `update.health_check` defaults to `checks`,
+      so with checks present that means "the port answers" — which no task
+      state ever does. Measured on 2026-08-22: Open WebUI's container started
+      at T+178 s and the first HTTP response came at T+200 s.
+
+    A group with no checks falls back to the first condition alone, so nothing
+    that cannot express readiness can get stuck reporting `starting` forever.
+    """
+    if unstarted_user_tasks(tasks, alloc):
+        return False
+    if any(s.get("Checks") for s in (services or [])):
+        return (alloc.get("DeploymentStatus") or {}).get("Healthy") is True
+    return True
+
+
+def placement_status(evals):
+    """Turn a job's evaluations into a (status, message) pair.
+
+    Three cases where upstream had one. No failure recorded means Nomad has
+    simply not run a scheduling pass yet; a non-empty `BlockedEval` means it
+    will retry when capacity changes; only the remainder is an error. The
+    detail lives on whichever evaluation actually carries `FailedTGAllocs` —
+    `/v1/job/:id/evaluations` returns them unordered, and the first one back is
+    frequently the blocked evaluation, which carries none.
+    """
+    blocked = any(e.get("BlockedEval") for e in evals)
+    failed = next((e for e in evals if e.get("FailedTGAllocs")), None)
+
+    if failed is None:
+        return (
+            "queued",
+            "Scheduling. Nomad has accepted this deployment and has not placed "
+            "it on a node yet.",
+        )
+
+    reasons = []
+    for group in failed["FailedTGAllocs"].values():
+        for dim, n in sorted((group.get("DimensionExhausted") or {}).items()):
+            reasons.append(f"{dim!r} exhausted on {n} node(s)")
+        for constraint, n in sorted((group.get("ConstraintFiltered") or {}).items()):
+            reasons.append(f"{n} node(s) filtered by constraint {constraint!r}")
+    detail = f" Nomad reports: {'; '.join(reasons)}." if reasons else ""
+
+    if blocked:
+        return (
+            "queued",
+            "Waiting for cluster capacity. This deployment will start on its own "
+            "when resources free up; deleting another deployment frees them "
+            f"sooner.{detail}",
+        )
+    return ("error", f"This deployment could not be placed on any node.{detail}")
+
+
