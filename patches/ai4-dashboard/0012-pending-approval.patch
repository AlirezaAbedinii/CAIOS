 } from '@angular/core';
 import { ActivatedRoute } from '@angular/router';
 import { MatCard, MatCardContent } from '@angular/material/card';
+import { TranslatePipe } from '@ngx-translate/core';
+import { AuthService } from '@app/core/services/auth/auth.service';
 
 @Component({
     selector: 'app-forbidden',
     templateUrl: './forbidden.component.html',
     styleUrls: ['./forbidden.component.scss'],
     changeDetection: ChangeDetectionStrategy.Eager,
-    imports: [MatCard, MatCardContent],
+    imports: [MatCard, MatCardContent, TranslatePipe],
 })
 export class ForbiddenComponent implements OnInit {
     route = inject(ActivatedRoute);
+    private authService = inject(AuthService);
 
     errorMessage = '';
 
+    /**
+     * [CAIOS] Signed in, and holding no access level at all.
+     *
+     * That is not the same thing as being refused, and it should not read like
+     * it. Since T6 anybody can register, so the most common visitor to this
+     * page is now someone who has just signed up and is waiting to be let in —
+     * and "You don't have the rights to do that!" tells them nothing they can
+     * act on.
+     *
+     * Read from the token the browser already holds: `isAuthenticated` is set
+     * by AuthService only when the token carries an access:<vo>:<level> role,
+     * so false-while-signed-in is exactly the pending state. No extra request,
+     * and no second opinion about who somebody is.
+     */
+    isPendingApproval = false;
+
     ngOnInit(): void {
         this.errorMessage =
             this.route.snapshot.paramMap.get('errorMessage') || '';
+
+        const profile = this.authService.userProfileSubject.getValue();
+        this.isPendingApproval =
+            !!profile && profile.isAuthenticated === false;
     }
 }
