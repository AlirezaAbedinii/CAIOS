+def _task_failure_reason(alloc):
+    """[CAIOS] Why did this allocation's tasks fail, in one sentence.
+
+    Reads the task event stream Nomad already keeps. Prefers the `Terminated`
+    event, which carries the exit code and the container's own message, and
+    falls back to the last event of any failed task.
+
+    Returns "" when nothing useful is there — an empty message is honest, and
+    the caller leaves the field alone rather than inventing a reason.
+    """
+    reasons = []
+    for name, state in (alloc.get("TaskStates") or {}).items():
+        if not state.get("Failed"):
+            continue
+        events = state.get("Events") or []
+        chosen = next(
+            (e for e in reversed(events) if e.get("Type") == "Terminated"),
+            events[-1] if events else None,
+        )
+        if not chosen:
+            continue
+        msg = (chosen.get("DisplayMessage") or "").strip()
+        if msg:
+            reasons.append(f"task '{name}': {msg}")
+    return " | ".join(reasons)
+
