+
+/* [CAIOS] 0018. The slot around a dimmed card: it keeps pointer events, so its
+   tooltip can be reached, and it carries the notice as text, undimmed, so the
+   card says why it is grey without anyone hovering. */
+.demo-unavailable-slot {
+    position: relative;
+    height: 100%;
+
+    &.is-unavailable {
+        cursor: not-allowed;
+    }
+}
+
+.demo-unavailable-label {
+    position: absolute;
+    left: 50%;
+    bottom: 14px;
+    transform: translateX(-50%);
+    padding: 3px 12px;
+    border: 1px solid rgba(0, 0, 0, 0.18);
+    border-radius: 999px;
+    background: #ffffff;
+    color: #37474f;
+    font-size: 12px;
+    font-weight: 500;
+    white-space: nowrap;
+    pointer-events: none;
 }
