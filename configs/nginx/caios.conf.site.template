
server {
    listen 443 ssl http2${CAIOS_NGINX_DEFAULT};
    listen [::]:443 ssl http2${CAIOS_NGINX_DEFAULT};

    server_name dashboard.${CAIOS_NGINX_DOMAIN}
                api.${CAIOS_NGINX_DOMAIN}
                auth.${CAIOS_NGINX_DOMAIN}
                vault.${CAIOS_NGINX_DOMAIN};

    ssl_certificate     ${CAIOS_NGINX_CERT};
    ssl_certificate_key ${CAIOS_NGINX_KEY};
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;

    client_max_body_size 0;

    location / {
        proxy_pass https://caios_control_plane;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port  443;
        proxy_set_header X-Forwarded-Host  $host;

        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_buffering         off;
        proxy_request_buffering off;
        proxy_read_timeout      3600s;
        proxy_send_timeout      3600s;
    }
}

