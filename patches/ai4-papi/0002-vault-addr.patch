+# [CAIOS] Upstream points at AI4EOSC's Vault, whose JWT backend trusts their
+# Keycloak and not ours. This is on the critical path of the headline demo:
+# deploying the federated server calls create_secret() and create_vault_token()
+# before Nomad is ever contacted, so an unreachable or untrusting Vault fails
+# the FL deployment with an error that looks nothing like a Vault problem.
+VAULT_ADDR = os.environ.get(
+    "VAULT_ADDR", "https://secrets.services.ai4os.eu:8200/"
+)
+VAULT_AUTH_PATH = os.environ.get("VAULT_AUTH_PATH", "jwt-keycloak")
+
+# [CAIOS] Upstream sends an empty role. Vault treats that as a request for a
+# role literally named "" rather than as "use the backend's default_role", and
+# answers 403 permission denied — which surfaces from PAPI as a bare HTTP 500
+# on every deployment, with nothing pointing at Vault. Configuring the role
+# name explicitly avoids relying on that distinction at all.
+VAULT_ROLE = os.environ.get("VAULT_ROLE", "")
 VAULT_MOUNT_POINT = "/secrets/"
 
 
