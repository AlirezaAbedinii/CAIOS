+# [CAIOS] Warm/cold, read from Knative rather than guessed at (D-57).
+#
+# A serverless service that scales to zero has a state the user can feel: the
+# first request after an idle period pays a start-up cost. Nothing in the
+# dashboard said which state a service was in.
+#
+# The authoritative signal is a Knative Revision's status.actualReplicas --
+# present and non-zero means a container is up. Deliberately not inferred from
+# "was it called recently" or "is the image cached", because a proxy's failure
+# mode here is a badge reading WARM while the user waits.
+#
+# Unset OSCAR_K8S_TOKEN disables this entirely and every service reports
+# warm=None, which the dashboard renders as "unknown" rather than as cold. An
+# absent signal is not a cold service (D-39).
+OSCAR_K8S_API = os.getenv("OSCAR_K8S_API", "")
+OSCAR_K8S_TOKEN_PATH = os.getenv("OSCAR_K8S_TOKEN_PATH", "")
+
+
+@cached(cache=TTLCache(maxsize=16, ttl=10))
+def _knative_replicas():
+    """{revision name: actualReplicas} for every Knative revision, or None.
+
+    Cached for ten seconds: the Inference page asks once per service and the
+    answer is the same for all of them, so this is one call per page load
+    rather than one per row. Ten seconds is well under Knative's ~30s idle
+    window, so the badge cannot be more than one window stale.
+    """
+    if not (OSCAR_K8S_API and OSCAR_K8S_TOKEN_PATH):
+        return None
+    try:
+        with open(OSCAR_K8S_TOKEN_PATH) as f:
+            token = f.read().strip()
+        r = requests.get(
+            f"{OSCAR_K8S_API}/apis/serving.knative.dev/v1/revisions",
+            headers={"Authorization": f"Bearer {token}"},
+            verify=False,  # the OSCAR cluster's API server uses its own CA
+            timeout=5,
+        )
+        r.raise_for_status()
+        return {
+            i["metadata"]["name"]: (i.get("status", {}).get("actualReplicas") or 0)
+            for i in r.json().get("items", [])
+        }
+    except Exception:
+        # Never let a status badge break the listing it decorates.
+        return None
+
+
+def _warm_state(service_name, replicas):
+    """warm / cold / None for one service.
+
+    Knative names revisions `<service>-00001`, so a service is warm if any of
+    its revisions has a replica.
+    """
+    if replicas is None:
+        return None, None
+    owned = [n for r, n in replicas.items() if r.startswith(service_name)]
+    if not owned:
+        return None, None
+    return (max(owned) > 0), max(owned)
+
