# Upstream clones — read-only, never edited, never committed
vendor/

# Patched copies of upstream, produced by scripts/apply-patches.sh.
# Regenerated on demand; the patches in patches/ are the source of truth.
build/

# Secrets. Real values live here; committed files carry placeholders only.
.env
*.env
!*.env.template
!template.env
secrets/
*.pem
*.key
*.crt
*.p12
*.pfx
*.jks
*_token
*-token
vault-init.json
ansible-vault-pass*

# Timestamped backups written by the ops scripts before they rewrite a file
# in place (scripts/*.sh save `<file>.bak.<stage>-<date>`). Regenerable, and
# `configs/env/caios.env` is one of the files they copy — so the backup of a
# gitignored secrets file was NOT itself gitignored, and sat one `git add -A`
# away from being published. The rule matches the suffix rather than the
# directory, because the scripts write these next to whatever they edit.
*.bak.*

# Certificates produced by scripts/make-*-cert*.sh. Regenerable; the CA that
# signs them lives outside the repo in ~/caios-ca.*
certs/
compose/certs/
*.zip

# Datasets — public data, but too big to track
data/
demo/data/

# Rehearsal logs. The result JSONs next to them are kept; these are just the
# stdout of the last run and are regenerated by scripts/fl-rehearse.sh.
demo/fl/results/rehearsal/
*.nii
*.nii.gz
*.dcm
*.npz

# Ansible / SSH runtime
# NOTE: ansible/inventory/ IS tracked. Private IPs are not secrets and both
# engineers need the same inventory. Passwords go in ansible-vault, never here.
*.retry
ssh/config

# Python / Node
__pycache__/
*.py[cod]
.venv/
venv/
node_modules/
dist/

# Editors / OS
.DS_Store
.idea/
*.swp

# Rendered from templates by scripts/render-configs.sh
compose/generated/

# ---------------------------------------------------------------------------
# Local-only working documents.
#
# Internal framing — grant context, supervisor questions, team size, budget.
# Kept on disk, shared between us directly, never committed.
#
# The technical content that outlives them lives in README.md, docs/scope.md,
# docs/infrastructure.md, docs/decisions.md and docs/runbook.md.
# ---------------------------------------------------------------------------
CLAUDE.md
docs/context.md
docs/questions-for-supervisor.md
docs/phase-plan.md
docs/presentation.md

# Catch-all for internal notes: anything ending in .local.md, and a private/
# directory for whatever does not fit a rule above. Prefer these over
# remembering to add each new file.
*.local.md
private/
notes/

# ---------------------------------------------------------------------------
# Credentials and infrastructure detail.
#
# The repo is deliberately free of anything that grants access. Real values
# live in configs/env/caios.env (gitignored) or ansible-vault.
# ---------------------------------------------------------------------------
*.kubeconfig
*.ovpn
clouds.yaml
*openrc*
*-openrc.sh
id_rsa*
id_ed25519*
*.ppk
known_hosts
authorized_keys
*.token
*.secret
*credentials*
*.tfstate
*.tfstate.*

# Anything the tooling writes with real values in it
compose/generated/
configs/env/caios.env

# Unit-test virtualenv (scripts/run-tests.sh)
.venv-tests/

# Saved container images, kept as an instant rollback for a deployment that
# misbehaves. Regenerable from a git tag + scripts/build-dashboard.sh, so they
# are convenience rather than the source of truth — and far too large to track.
rollback/*.tar

# Screenshots of the running dashboard. Kept locally as the F0 regression
# baseline and as evidence of faults found by looking — see
# docs/screenshots/README.md — but never pushed: this repository is public and
# these are full-resolution captures of a live internal deployment, showing
# hostnames, account names and endpoints. Once in git history they cannot be
# taken back.
docs/screenshots/*/
