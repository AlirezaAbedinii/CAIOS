+# [CAIOS] Where the catalogue is read from, and how long we wait for it.
+#
+# Upstream hardcodes raw.githubusercontent.com and builds the marketplace from
+# it on every cold request: one fetch for the catalogue's .gitmodules, then one
+# per entry for its ai4-metadata.yml. That host is Fastly-fronted and went
+# unreachable from every CAIOS node for about three hours on 2026-09-01 while
+# api.github.com, github.com and Docker Hub all kept working.
+#
+# CATALOGUE_BASE_URL points at a local mirror with the same path layout
+# (<owner>/<repo>/<branch>/<file>), built by scripts/mirror-catalogue.sh. Left
+# unset this behaves exactly as upstream does.
+# `or` rather than a get() default: an unset variable and one set to the empty
+# string must behave the same, or a blank line in an env file silently points the
+# marketplace at nothing.
+CATALOGUE_BASE_URL = (
+    os.environ.get("CATALOGUE_BASE_URL") or "https://raw.githubusercontent.com"
+).rstrip("/")
+
+# (connect, read). Upstream passes no timeout at all, so an unreachable source
+# does not fail — it hangs the worker thread, and the dashboard shows a spinner
+# that never resolves. A page that errors can be understood; a page that spins
+# cannot.
+CATALOGUE_TIMEOUT = (5, 15)
+
