+def _minio_for_users(provider):
+    """
+    [CAIOS] The MinIO provider as a user should see it.
+
+    OSCAR's cluster config carries the address its JOBS reach MinIO on — here
+    the in-cluster http://minio.minio.svc.cluster.local:9000 (D-36) — and
+    upstream shows that on the Inference detail page as "MINIO URL". Nobody
+    outside the cluster can open it. CAIOS_OSCAR_MINIO_URL replaces it in what
+    PAPI returns, with the MinIO console users actually upload to; the
+    services themselves keep the in-cluster address. Unset behaves as upstream.
+    patches/README.md, 0023.
+    """
+    public = os.getenv("CAIOS_OSCAR_MINIO_URL", "")
+    return {**provider, "endpoint": public} if public else provider
+
