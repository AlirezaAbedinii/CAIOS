# CAIOS ingress for the control plane, on caios_server.
#
# Serves four hostnames over TLS and proxies each to a container on loopback.
#
# CERTIFICATES
# ------------
# Automatic HTTPS is switched off deliberately. Caddy's default is Let's
# Encrypt, which must reach this host from the public internet to verify the
# challenge — impossible on a private subnet behind a VPN, so it would retry
# forever and serve nothing usable. Its fallback, an internal CA, would work but
# means a second certificate authority to distribute alongside the one the
# deployments already use.
#
# Instead we serve a certificate issued from our own CA by
# scripts/make-control-plane-cert.sh. One CA for the whole platform: import
# caios-ca.pem once and the dashboard, the API, Keycloak, Vault and every
# deployment are all trusted.
#
# Deployment hostnames (*.pacs-deployments...) are Traefik's job on caios_edge,
# not Caddy's. Two ingresses, two certificates, one authority.

{
	# No ACME. See above.
	auto_https off
}

(caios_tls) {
	tls /etc/caddy/certs/control-plane.pem /etc/caddy/certs/control-plane.key
}

# ---------------------------------------------------------------------------
# Dashboard — the only hostname a demo audience ever sees.
# ---------------------------------------------------------------------------
https://{$CAIOS_DASHBOARD_HOST} {
	import caios_tls
	encode gzip
	reverse_proxy 127.0.0.1:8081
}

# ---------------------------------------------------------------------------
# PAPI. CORS is handled by PAPI itself from main.yaml's CORS_origins; adding
# headers here as well produces duplicates and browsers reject the response.
# ---------------------------------------------------------------------------
https://{$CAIOS_API_HOST} {
	import caios_tls
	encode gzip
	reverse_proxy 127.0.0.1:8000
}

# ---------------------------------------------------------------------------
# Keycloak.
#
# The scheme and host here must match KC_HOSTNAME and PAPI's KEYCLOAK_URL
# exactly. Every token carries the issuer as a literal string and PAPI compares
# it character by character — http vs https, or a trailing slash, is enough to
# fail every request with 401 and no useful explanation.
#
# X-Forwarded-Proto matters for the same reason: without it Keycloak believes it
# is being reached over plain HTTP and mints tokens with an http:// issuer.
# ---------------------------------------------------------------------------
https://{$CAIOS_AUTH_HOST} {
	import caios_tls
	encode gzip
	reverse_proxy 127.0.0.1:8180 {
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Port 443
	}
}

# ---------------------------------------------------------------------------
# Vault UI. Admin only — nothing in the demo touches this directly.
# Reachable only from the VPN, like everything else here.
# ---------------------------------------------------------------------------
https://{$CAIOS_VAULT_HOST} {
	import caios_tls
	reverse_proxy 127.0.0.1:8200
}

# ---------------------------------------------------------------------------
# Anything else arriving on port 80 or by bare IP. Answering plainly beats a
# confusing default page when someone mistypes a hostname.
# ---------------------------------------------------------------------------
:80 {
	respond "CAIOS. Use a hostname, not the bare address — see docs/runbook.md." 404
}
