# CAIOS public edge on jump-server (FLOATING_IP=${CAIOS_PUBLIC_IP}).
#
# GENERATED by scripts/render-nginx-config.sh from configs/nginx/*.template.
# Edit the templates, re-render, copy up. Editing this file on the proxy is
# lost the next time anybody renders.
#
# nginx terminates public TLS and forwards by Host: to Caddy (${CAIOS_CTRL_IP})
# and Traefik (${CAIOS_EDGE_IP}). Traefik's routes change with Nomad jobs —
# this file never names a deployment.
#
#   !!  THIS MACHINE ALSO SERVES A PROJECT THAT IS NOT CAIOS.  !!
#
# /etc/nginx/conf.d/seventask.conf proxies an unrelated application on :8888.
# Two consequences, and the second one is not obvious:
#
#   1. Only ever replace /etc/nginx/conf.d/caios.conf. Never nginx.conf,
#      never seventask.conf, and never anything in sites-enabled.
#   2. The `map $$http_upgrade $$connection_upgrade` block below lives in the
#      http context, and seventask.conf USES IT without defining its own —
#      deliberately, because a duplicate map is a global nginx syntax error.
#      So removing or renaming it here breaks WebSockets for that project, and
#      defining a second one stops nginx starting at all. It stays here,
#      spelled exactly this way.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream caios_control_plane { server ${CAIOS_CTRL_IP}:443; }
upstream caios_deployments   { server ${CAIOS_EDGE_IP}:443; }

# The internal leg is HTTPS and it is VERIFIED. Caddy and Traefik must each
# present a certificate valid for the hostname the visitor asked for, because
# proxy_ssl_name is $host. Moving the platform to a new domain without
# reissuing BOTH internal certificates with the new SANs turns every request
# into a 502, behind a public certificate a browser calls perfectly valid.
proxy_ssl_trusted_certificate /etc/nginx/certs/caios-ca.pem;
proxy_ssl_verify              on;
proxy_ssl_verify_depth        2;
proxy_ssl_server_name         on;
proxy_ssl_name                $host;

# Everything on :80, for every hostname on this machine's :80, including names
# this file knows nothing about. CAIOS is HTTPS-only (D-68, gotcha 23).
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    return 301 https://$host$request_uri;
}
