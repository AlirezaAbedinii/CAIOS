     MAIN_CONF = yaml.safe_load(f)
 
 
+# [CAIOS] T5. The scheme this platform serves on, and the Traefik router tag
+# that follows from it.
+#
+# One variable in configs/env/caios.env decides it; compose passes it in. Unset
+# means https, which is exactly what upstream hardcoded, so an image built
+# without it behaves as it always did.
+CAIOS_SCHEME = os.environ.get("CAIOS_SCHEME", "https") or "https"
+
+# https -> tls=true         a TLS router on every entrypoint. Upstream's literal.
+# http  -> entrypoints=web  a plain router on :80 only.
+#
+# Deliberately not "tls=false". That would depend on how Traefik's label parser
+# treats a false value for a struct-pointer field — true of this version, and
+# not a thing to bet a demo on when naming the entrypoint says the same thing
+# in a way that cannot be misread.
+CAIOS_ROUTER_TLS = "tls=true" if CAIOS_SCHEME == "https" else "entrypoints=web"
+
+
 def load_nomad_job(fpath: Path) -> Template:
     """
     Load default Nomad job configuration
     """
-    return Template(fpath.read_text(encoding="utf-8"))
+    raw = fpath.read_text(encoding="utf-8")
+
+    # [CAIOS] Fill in the router tag before the Template is built.
+    #
+    # Here rather than at the call sites because this is the ONE place every job
+    # template is read, while the call sites each assemble their own
+    # substitution dict — five dicts, five chances to miss one. A missed one is
+    # not loud: safe_substitute leaves ${CAIOS_ROUTER_TLS} in place, Consul
+    # accepts it as a tag, Traefik ignores a tag it cannot parse, and the
+    # deployment comes up healthy with no route to it at all.
+    raw = raw.replace("${CAIOS_ROUTER_TLS}", CAIOS_ROUTER_TLS)
+
+    return Template(raw)
 
 
 def load_yaml_conf(fpath: Path) -> tuple[dict[str, Any], dict[str, Any]]:
