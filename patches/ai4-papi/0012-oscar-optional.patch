+def oscar_cluster_conf(vo):
+    """
+    [CAIOS] Return the OSCAR cluster configured for this VO, or None.
+
+    Upstream indexes `MAIN_CONF["oscar"]["clusters"][vo]` directly, because
+    AI4EOSC runs an OSCAR cluster for every VO it serves. We run none, so the
+    `oscar` block is absent from main.yaml entirely (D-09) and that lookup
+    raises KeyError, which FastAPI turns into a bare HTTP 500.
+    """
+    return papiconf.MAIN_CONF.get("oscar", {}).get("clusters", {}).get(vo)
+
+
+def require_oscar(vo):
+    """
+    [CAIOS] Fail with an explanation instead of a bare 500.
+
+    This router is mounted unconditionally in routers/v1/__init__.py, and the
+    dashboard hardcodes a sidenav link to /tasks/inference, so every endpoint
+    here is reachable on a cluster that has no OSCAR at all.
+
+    D-39: "waiting" and "failed" are different words. A feature this cluster
+    does not offer is 501 Not Implemented with a sentence saying so, not a 500
+    that reads like something broke.
+
+    Every read of the cluster config goes through here, rather than only the
+    ones on the client path. `create_service` calls `make_service_definition`
+    BEFORE it builds a client, so guarding only `get_client_from_auth` would
+    leave that endpoint raising KeyError exactly as before.
+    """
+    conf = oscar_cluster_conf(vo)
+    if not conf:
+        raise HTTPException(
+            status_code=501,
+            detail=(
+                "Serverless inference (OSCAR) is not configured on this cluster"
+                f" for VO '{vo}'. See docs/oscar-plan.md."
+            ),
+        )
+    return conf
+
+
