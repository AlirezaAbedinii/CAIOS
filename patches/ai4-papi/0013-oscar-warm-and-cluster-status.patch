+@router.get("/cluster/status")
+def get_cluster_status(
+    vo: str,
+    authorization=Depends(security),
+):
+    """
+    [CAIOS] Capacity and health of the OSCAR cluster.
+
+    Upstream offers /cluster, which returns version strings. The dashboard also
+    wants to show what the cluster IS -- nodes, cores, memory, GPUs -- and the
+    Statistics page cannot help: it reads Nomad, and the OSCAR node is
+    deliberately outside the Nomad cluster so the two orchestrators cannot
+    destabilise each other.
+
+    OSCAR reports all of it at /system/status, so this proxies that rather than
+    inventing a second source of truth.
+    """
+    auth_info = auth.get_user_info(authorization.credentials)
+    auth.check_authorization(auth_info, vo)
+    cluster = require_oscar(vo)
+
+    r = requests.get(
+        f"{cluster['endpoint']}/system/status",
+        headers={"Authorization": f"Bearer {authorization.credentials}"},
+        timeout=10,
+    )
+    r.raise_for_status()
+    return r.json()
