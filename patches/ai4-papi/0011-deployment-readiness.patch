+# [CAIOS] Two helpers for describing a deployment honestly. Both are pure
+# functions over data `get_deployment` has already fetched, so they cost no
+# extra Nomad calls and can be unit-tested without a cluster.
+
+
+def unstarted_user_tasks(tasks, alloc):
+    """Names of the tasks a user actually opens that Nomad has not started yet.
+
+    Tasks carrying a `lifecycle` block are plumbing: prestart sidecars and
+    one-shot setup. The tasks without one are the deployment proper. Nomad has
+    not started a task until it has a StartedAt, which it serialises either as
+    null or as the zero time.
+    """
+    states = alloc.get("TaskStates") or {}
+    unstarted = []
+    for t in tasks:
+        if t.get("Lifecycle"):
+            continue
+        started = (states.get(t["Name"]) or {}).get("StartedAt")
+        if not started or (
+            isinstance(started, str) and started.startswith("0001-01-01")
+        ):
+            unstarted.append(t["Name"])
+    return unstarted
+
+
+def placement_status(evals):
+    """Turn a job's evaluations into a (status, message) pair.
+
+    A non-empty `BlockedEval` is Nomad saying it will retry when capacity
+    changes. That is `queued`, not `error`. The detail lives on whichever
+    evaluation actually carries `FailedTGAllocs` — `/v1/job/:id/evaluations`
+    returns evaluations unordered, and the first one back is frequently the
+    blocked evaluation, which carries none.
+    """
+    blocked = any(e.get("BlockedEval") for e in evals)
+    failed = next((e for e in evals if e.get("FailedTGAllocs")), None)
+
+    reasons = []
+    for group in (failed or {}).get("FailedTGAllocs", {}).values():
+        for dim, n in sorted((group.get("DimensionExhausted") or {}).items()):
+            reasons.append(f"{dim!r} exhausted on {n} node(s)")
+        for constraint, n in sorted((group.get("ConstraintFiltered") or {}).items()):
+            reasons.append(f"{n} node(s) filtered by constraint {constraint!r}")
+    detail = f" Nomad reports: {'; '.join(reasons)}." if reasons else ""
+
+    if blocked:
+        return (
+            "queued",
+            "Waiting for cluster capacity. This deployment will start on its own "
+            "when resources free up; deleting another deployment frees them "
+            f"sooner.{detail}",
+        )
+    return (
+        "error",
+        "This deployment could not be placed on any node."
+        + (detail or " Nomad reported no placement detail."),
+    )
+
