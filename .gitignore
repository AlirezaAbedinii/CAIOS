# Upstream clones — read-only, never edited, never committed
vendor/

# Patched copies of upstream, produced by scripts/apply-patches.sh.
# Regenerated on demand; the patches in patches/ are the source of truth.
build/

# Secrets. Real values live here; committed files carry placeholders only.
.env
*.env
!*.env.template
!template.env
secrets/
*.pem
*.key
*.crt
*.p12
*.pfx
*.jks
*_token
*-token
vault-init.json
ansible-vault-pass*

# Certificate bundles produced by scripts/make-traefik-certs.sh
certs/
*.zip

# Datasets — public data, but too big to track
data/
demo/data/
*.nii
*.nii.gz
*.dcm
*.npz

# Ansible / SSH runtime
# NOTE: ansible/inventory/ IS tracked. Private IPs are not secrets and both
# engineers need the same inventory. Passwords go in ansible-vault, never here.
*.retry
ssh/config

# Python / Node
__pycache__/
*.py[cod]
.venv/
venv/
node_modules/
dist/

# Editors / OS
.DS_Store
.idea/
*.swp

# Rendered from templates by scripts/render-configs.sh
compose/generated/

# ---------------------------------------------------------------------------
# Local-only working documents.
#
# These stay on disk and are shared between the two of us by other means; they
# are not in the public repository because they contain internal framing —
# grant context, supervisor questions, team size and budget.
#
# The technical content that outlives them lives in README.md, docs/scope.md,
# docs/infrastructure.md, docs/decisions.md and docs/runbook.md.
# ---------------------------------------------------------------------------
CLAUDE.md
docs/context.md
docs/questions-for-supervisor.md
docs/phase-plan.md
